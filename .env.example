# User configuration only: ~/.config/ygg/.env, or $YGG_CONFIG_DIR/.env.
# Repository-local .env files are not loaded. Existing environment values win.
# With no mode or URL, `ygg init` selects managed PostgreSQL.
# To use external PostgreSQL, uncomment and set your own URL:
# YGG_DB_MODE=external
# DATABASE_URL=postgres://ygg_runtime:password@db.example/ygg?sslmode=verify-full
# YGG_DATABASE_OWNER_URL=postgres://ygg_owner:password@db.example/ygg?sslmode=verify-full
# Explicit managed mode conflicts with any configured DATABASE_URL.
# YGG_DB_MODE=managed
# YGG_DATA_DIR=/absolute/private/ygg-data
# YGG_PROFILE=default
# YGG_KNOWLEDGE_DIR=/absolute/private/knowledge
# YGG_KNOWLEDGE_POLICY_DIR=/absolute/private/knowledge-policy
# Knowledge paths alone do not activate OKF; use the validated migration workflow.
CONTEXT_LIMIT_TOKENS=250000
CONTEXT_HARD_CAP_TOKENS=300000
LOCK_TTL_SECS=300
HEARTBEAT_INTERVAL_SECS=60
WATCHER_INTERVAL_SECS=30
RTK_BINARY_PATH=rtk
RUST_LOG=ygg=info
